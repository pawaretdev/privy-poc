# PUBLIC: your OWN Privy app (not Ronin Stash)
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=

# Firebase Console > Project settings > Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# SERVER ONLY; app ID must match VITE_PRIVY_APP_ID
PRIVY_APP_ID=
PRIVY_APP_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Quoted PEM; use literal backslash-n for newlines
FIREBASE_PRIVATE_KEY=""
# Alternative to client email/private key: JSON file OUTSIDE this repo
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Independent Stash demo
VITE_STASH_APP_ID=cmpkwmb7l001c0bjp3sdn6n8e
# VITE_RONIN_RPC_URL=
# Firebase wallet card reads RON balance on Saigon testnet (defaults to public RPC)
# VITE_SAIGON_RPC_URL=
API_PORT=8001
PRIVY_JWT_ISSUER=https://fe.pawaret.uk
# Privy JWT dashboard JWKS URL: https://fe.pawaret.uk/api/.well-known/jwks.json
# Signing key auto-generated in data/privy-jwt-private.pem; never publish it.
APP_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://fe.pawaret.uk
