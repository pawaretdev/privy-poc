# PUBLIC: your OWN Privy app (not Ronin Stash)
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=

# Firebase Console > Project settings > Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# SERVER ONLY; app ID must match VITE_PRIVY_APP_ID
PRIVY_APP_ID=
PRIVY_APP_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Quoted PEM; use literal backslash-n for newlines
FIREBASE_PRIVATE_KEY=""
# Alternative to client email/private key: JSON file OUTSIDE this repo
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Independent Stash demo
VITE_STASH_APP_ID=cmpkwmb7l001c0bjp3sdn6n8e
# VITE_RONIN_RPC_URL=
# Firebase wallet card reads RON balance on Saigon testnet (defaults to public RPC)
# VITE_SAIGON_RPC_URL=
API_PORT=8001
PRIVY_JWT_ISSUER=https://fe.pawaret.uk
# Privy JWT dashboard JWKS URL: https://fe.pawaret.uk/api/.well-known/jwks.json
# Signing key auto-generated in data/privy-jwt-private.pem; never publish it.
APP_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://fe.pawaret.uk

# thirdweb in-app wallet POC (/thirdweb.html) — see docs/thirdweb-setup.md
# PUBLIC: thirdweb project client ID (never put the thirdweb secret key here)
VITE_THIRDWEB_CLIENT_ID=
# 7702 (default: sponsored EIP-7702, keeps the EOA address) or 4337 (sponsored ERC-4337 smart account)
# VITE_THIRDWEB_EXECUTION_MODE=7702
# 2020 (Ronin mainnet, default) or 202601 (Saigon). thirdweb's bundler rejected 202601 as of 2026-10-16.
# VITE_THIRDWEB_CHAIN=2020
# SERVER ONLY: `aud` of the bridge JWT; must equal the dashboard "AUD value". Defaults to VITE_THIRDWEB_CLIENT_ID.
# THIRDWEB_JWT_AUDIENCE=
# SERVER ONLY: thirdweb project secret key (dashboard → Project Settings). Used by POST /api/thirdweb/wallet/sync to confirm
# the wallet belongs to the Firebase UID before saving it. Never expose it to the browser (no VITE_ prefix).
THIRDWEB_SECRET_KEY=
# SERVER ONLY: thirdweb server verifier. Set the same value as custom header `x-verifier-secret` in the dashboard.
THIRDWEB_VERIFIER_SECRET=
# Mavis Market items whose buys are sponsored: 0xCollection:tokenId (or :* for the whole collection), comma-separated.
# Default: Chicken Saga Resources #32 only.
# THIRDWEB_SPONSOR_ITEMS=0xac78515ef7d0bb935bc86d4f8ce314038946b52f:32
# The thirdweb bridge reuses PRIVY_JWT_ISSUER and the same signing key / JWKS URL as the Privy bridge.
